<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Broken-white window background matches the app canvas; avoids
         white flash during the system splash / activity start. -->
    <style name="Theme.FujiRecipes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F4F0</item>
        <item name="android:statusBarColor">#F7F4F0</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F7F4F0</item>
    </style>
</resources>
